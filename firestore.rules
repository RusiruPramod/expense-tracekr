rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isMemberOfGroup(groupId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/groups/$(groupId)) &&
        'memberIds' in get(/databases/$(database)/documents/groups/$(groupId)).data &&
        request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
    }

    // Users - authenticated users can read all profiles, write only their own
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == userId;
    }

    // Groups
    match /groups/{groupId} {
      allow create: if isSignedIn();
      allow read, update, delete: if isSignedIn() && (
        resource == null ||
        (
          'memberIds' in resource.data &&
          request.auth.uid in resource.data.memberIds
        )
      );

      // Expenses subcollection
      match /expenses/{expenseId} {
        allow read, write: if isMemberOfGroup(groupId);
      }

      // Settlements subcollection
      match /settlements/{settlementId} {
        allow read, write: if isMemberOfGroup(groupId);
      }
    }
  }
}
